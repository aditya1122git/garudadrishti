# Live monitoring is the secure default.
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=jannetra
# Required for live mode. Generate independent random secrets; see README.
JWT_SECRET=
ENCRYPTION_KEY=
# First startup only. Remove both after the administrator exists in MongoDB.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Local inference; public model downloads need no API key.
HF_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
HF_REVISION=f2f1202b1bdeb07342385c3f807f9c07cd8f5cf8
HF_TOKEN=
HF_CACHE_DIR=.cache/huggingface
HF_DEVICE=cpu
HF_BATCH_SIZE=16
HF_MAX_LENGTH=256
HF_CPU_THREADS=2
# Enable only after downloading the model into the cache.
HF_LOCAL_FILES_ONLY=false
YOUTUBE_API_KEY=
YOUTUBE_INITIAL_LOOKBACK_DAYS=7
YOUTUBE_TERMS_PER_QUERY=4
# Only the token is required. JanNetra selects tested default Actors and inputs.
# The Actor IDs and input JSON values below are optional advanced overrides.
APIFY_API_TOKEN=
APIFY_FACEBOOK_ACTOR_ID=
APIFY_INSTAGRAM_ACTOR_ID=
APIFY_X_ACTOR_ID=
APIFY_NEWS_ACTOR_ID=
APIFY_FACEBOOK_INPUT_JSON=
APIFY_INSTAGRAM_INPUT_JSON=
APIFY_X_INPUT_JSON=
APIFY_NEWS_INPUT_JSON=
APIFY_MAX_ITEMS=50
APIFY_RUN_TIMEOUT_SECONDS=240
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SENDGRID_API_KEY=
# Both values enable one Telegram alert for every newly classified negative post.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated approved webhook destination hostnames. No wildcards.
OUTBOUND_ALLOWED_HOSTS=
REPORTING_TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true
SYNC_INTERVAL_MINUTES=15
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
HF_CONFIDENCE_THRESHOLD=0.75
GROQ_CONCURRENCY=2
ENABLED_PLATFORMS=facebook,instagram,x,youtube,news
