# Live monitoring is the secure default.
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=jannetra
# Public host port used by the frontend container. Use 80 for direct HTTP
# when no other VPS service occupies port 80; otherwise keep 8080.
PUBLIC_PORT=8080
# Required for live mode. Generate independent random secrets; see README.
JWT_SECRET=
ENCRYPTION_KEY=
# First startup only. Remove both after the administrator exists in MongoDB.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Local inference; public model downloads need no API key.
HF_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
HF_REVISION=f2f1202b1bdeb07342385c3f807f9c07cd8f5cf8
HF_TOKEN=
HF_CACHE_DIR=.cache/huggingface
HF_DEVICE=cpu
HF_BATCH_SIZE=16
HF_MAX_LENGTH=256
HF_CPU_THREADS=2
# Enable only after downloading the model into the cache.
HF_LOCAL_FILES_ONLY=false
# Hindi/Hinglish sarcasm signal. This repository has no tokenizer files, so
# JanNetra explicitly uses the pinned tokenizer from its declared base model.
SARCASM_MODEL=ashish5193/sarcasm_model
SARCASM_REVISION=6e8df8df0e3ff4adf248a15f06057cd6b7b173b2
SARCASM_TOKENIZER_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SARCASM_TOKENIZER_REVISION=3216a57f2a0d9c45a2e6c20157c20c49fb4bf9c7
SARCASM_CONFIDENCE_THRESHOLD=0.65
YOUTUBE_API_KEY=
YOUTUBE_INITIAL_LOOKBACK_DAYS=7
YOUTUBE_TERMS_PER_QUERY=4
# Only the token is required. JanNetra selects tested default Actors and inputs.
# The Actor IDs and input JSON values below are optional advanced overrides.
APIFY_API_TOKEN=
APIFY_FACEBOOK_ACTOR_ID=
APIFY_INSTAGRAM_ACTOR_ID=
APIFY_X_ACTOR_ID=
APIFY_FACEBOOK_INPUT_JSON=
APIFY_INSTAGRAM_INPUT_JSON=
APIFY_X_INPUT_JSON=
APIFY_MAX_ITEMS=50
APIFY_RUN_TIMEOUT_SECONDS=240
# Both values enable one Telegram alert for every newly classified negative post.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORTING_TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true
# Automatic work runs only from 06:00 through the final 22:00 slot (IST).
AUTOMATION_START_HOUR=6
AUTOMATION_END_HOUR=22
YOUTUBE_SYNC_INTERVAL_MINUTES=15
APIFY_SYNC_INTERVAL_HOURS=4
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
HF_CONFIDENCE_THRESHOLD=0.60
GROQ_CONCURRENCY=2
ENABLED_PLATFORMS=facebook,instagram,x,youtube,news
