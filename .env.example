# Docker defaults to demo. Never expose demo mode publicly.
SEED_MOCK_DATA=true
DEMO_IN_MEMORY=false
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=jannetra
# Required for live mode. Generate independent random secrets; see README.
JWT_SECRET=
ENCRYPTION_KEY=
BOOTSTRAP_EMAIL=admin@jannetra.local
BOOTSTRAP_PASSWORD=
# Local inference; public model downloads need no API key.
HF_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
HF_REVISION=f2f1202b1bdeb07342385c3f807f9c07cd8f5cf8
HF_TOKEN=
HF_CACHE_DIR=.cache/huggingface
HF_DEVICE=cpu
HF_BATCH_SIZE=16
HF_MAX_LENGTH=256
HF_CPU_THREADS=2
# Enable only after downloading the model into the cache.
HF_LOCAL_FILES_ONLY=false
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
META_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=v23.0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SENDGRID_API_KEY=
# Comma-separated approved webhook / provider adapter hostnames. No wildcards.
OUTBOUND_ALLOWED_HOSTS=
REPORTING_TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true
SYNC_INTERVAL_MINUTES=15
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
